// Secrets.example.xcconfig — template for macos/Config/Secrets.xcconfig, which is
// git-ignored and included by Waverly.xcconfig at build time:
//
//   cp macos/Config/Secrets.example.xcconfig macos/Config/Secrets.xcconfig
//
// Fill in an OAuth client of type "Desktop app" from Google Cloud Console
// (APIs & Services > Credentials), in a project with the Google Calendar API and
// the Google Tasks API enabled and the scopes calendar.readonly + tasks
// on its consent screen. Google treats a desktop app's client secret as not
// confidential (it ships inside the app), but keep it out of the repository.
// Write the values without quotes.
GOOGLE_CLIENT_ID = 1234567890-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = GOCSPX-replace-with-your-secret
