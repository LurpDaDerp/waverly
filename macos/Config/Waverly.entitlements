<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Waverly is NOT sandboxed: it launches Python helpers from Application Support,
  installs a global key event tap (Accessibility permission) and shares memory
  with the engine. Distribute it outside the Mac App Store (Developer ID, or
  ad-hoc "Sign to Run Locally"). Hardened Runtime stays on, library validation
  included: Python, uv and the setup script run as separate processes, and
  nothing loads code into Waverly's own process.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>                       <false/>
    <key>com.apple.security.device.camera</key>                     <true/>
    <key>com.apple.security.personal-information.location</key>     <true/>
</dict>
</plist>
